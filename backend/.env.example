# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production
FRONTEND_URL=http://localhost:5173
APP_NAME=Portfolio

# ==============================================================================
# MONGODB CONFIGURATION
# Enter your MongoDB connection URI below.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
# ==============================================================================
MONGO_URI=

# ==============================================================================
# CLOUDINARY CONFIGURATION
# Enter your Cloudinary credentials below (found in Cloudinary Console / Dashboard).
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ==============================================================================
# AI ASSISTANT CONFIGURATION (OPTIONAL)
# Used for the Resume Builder AI bullet point enhancement & summary polish
# Provide an OpenAI API key or Gemini API key
# ==============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# Used by Nodemailer to notify you when someone submits the contact form
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
